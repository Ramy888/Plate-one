<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Flutter only injects INTERNET into the debug and profile manifests.
         Without it here, every networked feature fails in release builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Scanning a meal. Photos are cropped and stripped of metadata on the
         device before anything is sent, and never stored on our servers. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- A phone without a camera can still use the whole app by hand. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- The camera plugin declares these for video recording and legacy file
         access. Plate One takes one still photo with audio disabled and
         writes nothing to shared storage, so they are stripped: asking for a
         microphone in a nutrition app is a review question we should not have
         to answer, and READ_EXTERNAL_STORAGE drags the listing into Play's
         Photo and Video Permissions policy for no benefit. -->
    <!-- Voice: recorded only while the mic is held, sent to be read, and never
         kept on the phone or on our server. Stripped again the day voice goes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>

    <application
        android:label="Plate One"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher needs this to open the privacy policy and terms
             on Android 11+ package-visibility rules. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
