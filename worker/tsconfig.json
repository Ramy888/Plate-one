{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-pool-workers"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
